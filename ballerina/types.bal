    string? taxRateName?;
    # A unique GUID for the line item
    @jsondata:Name {value: "LineItemKey"}
    string lineItemKey?;
    # The amount of the line item calculated as UnitPrice * Quantity, excluding taxes
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The percentage tax rate, expressed as an integer - e.g. 15% is rendered as 15.0000
    @jsondata:Name {value: "TaxRate"}
    decimal? taxRate?;
    # The quantity of units for a line item
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # The source type of the line item
    @jsondata:Name {value: "BillableItemType"}
    "TimeEntry"|"Expense"|"Entity" billableItemType?;
};

