# A single Work Schedule
public type WorkScheduleRequest record {
    # The unit of time at which this Work Schedule should repeat. Once set, the value of this property can not be changed
    @jsondata:Name {value: "RecurrenceFrequency"}
    "Day"|"Week"|"SemiMonth"|"Fortnight"|"Month"|"Quarter"|"Year"|"Custom" recurrenceFrequency;
    # The unit of time at which this Work Schedule should repeat. Once set, the value of this property can not be changed.
    # 
    # This property is only applicable if `RecurrenceFrequency` is set to `Custom`
    @jsondata:Name {value: "CustomFrequencyUnits"}
    "Days"|"Weeks"|"Months"|"Years"? customFrequencyUnits?;
    # You can automatically create a Work Item before its Start date. Use this property to set the unit of delay between Start date and Work Item creation date
    @jsondata:Name {value: "InitializeBeforeStartDateUnits"}
    "Days"|"Weeks"|"Months"|"Years" initializeBeforeStartDateUnits?;
    # Use this property to define the format of the Work Item title. Karbon offers a series of object that you can use to construct Work Item Title. For more information, see Technical Guide to Work Item Title Definition
    @jsondata:Name {value: "WorkItemTitleDefinition"}
    string workItemTitleDefinition;
    # You can automatically create budget and tasks for a Work Item before its Start date. Use this property to set the multiple of delay unit between Start date and task creation date
    @jsondata:Name {value: "InitializeTasksBeforeStartDateMultiple"}
    int:Signed32 initializeTasksBeforeStartDateMultiple;
    # The value of the count for the Due Date
    # 
    # This property is not applicable if `ScheduleDueDateMethod` is set to `LastDayOfMonth` or `NoDueDate`.
    # 
    # Example of usage: <table> <thead>
    # <th>ScheduleDueDateMethod</th>
    # <th>ScheduleDueDateDays</th>
    # <th>Read Due Date as</th>
    # </thead> <tbody>
    # <tr>
    # <td>DaysFromStartDate</td>
    # <td>7</td>
    # <td>7 days after start date</td>
    # </tr>
    # <tr>
    # <td>DayOfMonth</td>
    # <td>7</td>
    # <td>7th day of the current month</td>
    # </tr>
    # <tr>
    # <td>LastDayOfMonth</td>
    # <td>N/A</td>
    # <td>Last day of the current month</td>
    # </tr>
    # <tr>
    # <td>DayOfNextMonth</td>
    # <td>7</td>
    # <td>7th day of the next month</td>
    # </tr>
    # <tr>
    # <td>NoDueDate</td>
    # <td>N/A</td>
    # <td>Work has no due date</td>
    # </tr>
    # </tbody> </table>
    @jsondata:Name {value: "ScheduleDueDateDays"}
    int:Signed32 scheduleDueDateDays?;
    # You can automatically create budget and tasks for a Work Item before its Start date. Use this property to set the unit of delay between Start date and task creation date
    @jsondata:Name {value: "InitializeTasksBeforeStartDateUnits"}
    "Days"|"Weeks"|"Months"|"Years" initializeTasksBeforeStartDateUnits;
    # The key of an existing Karbon user to assign the Work Schedule's generated Work Items to. On PUT, a null or omitted value leaves the current assignee unchanged. Once set, assignee cannot be cleared. Changing the assignee reassigns every incomplete Work Item in the series; completed Work Items are unchanged
    @jsondata:Name {value: "AssigneeUserKey"}
    string? assigneeUserKey?;
    # The date at which this Work Schedule should start running
    @jsondata:Name {value: "ScheduleStartDate"}
    string scheduleStartDate;
    # The multiple of time unit at which this Work Schedule should repeat.  This property is not applicable if `RecurrenceFrequency` is set to `SemiMonth`, `Fortnight`, or `Quarter`
    @jsondata:Name {value: "CustomFrequencyMultiple"}
    int:Signed32 customFrequencyMultiple;
    # The date at which this Work Schedule should stop running
    # 
    # To set the Work Schedule to run forever, set the value of this property to `null`
    @jsondata:Name {value: "ScheduleEndDate"}
    string scheduleEndDate?;
    # The method that should be used to count the Deadline Date for the Work Item.
    # 
    # Companies House-driven and filing-date-driven deadline methods are not available through the API; setting `ScheduleDeadlineDateMethod` to `CompaniesHouseAccountsDueDate`, `CompaniesHouseConfirmationStatementDueDate` or `OnFilingDate` returns a `400`.
    # 
    # On `PUT`, omitting this property leaves the existing deadline date configuration unchanged. To remove a deadline date, set this to `NoDeadlineDate` explicitly
    @jsondata:Name {value: "ScheduleDeadlineDateMethod"}
    "DaysFromStartDate"|"DayOfMonth"|"LastDayOfMonth"|"DayOfNextMonth"|"DayOfSubsequentMonth"|"NoDeadlineDate" scheduleDeadlineDateMethod?;
    # The key of the Work Item, which the Work Schedule will be assigned to. This value will be `null`
    @jsondata:Name {value: "CreatedFromWorkItemKey"}
    string createdFromWorkItemKey;
    # The value to denote the number of the months, if the due date is after 2 months.
    # 
    # This property is only applicable if `ScheduleDueDateMethod` is set to `DayOfSubsequentMonth`.
    # 
    # Example of usage: <table> <thead>
    # <th>ScheduleDueDateMethod</th>
    # <th>ScheduleDueDateDays</th>
    # <th>ScheduleDueDateMonthMultiple</th>
    # <th>Read Due Date as</th>
    # </thead> <tbody>
    # <tr>
    # <td>DaysFromStartDate</td>
    # <td>7</td>
    # <td>3</td>
    # <td>7th day of the 3rd month after start date</td>
    # </tr>
    # </tbody> </table>
    @jsondata:Name {value: "ScheduleDueDateMonthMultiple"}
    int:Signed32 scheduleDueDateMonthMultiple?;
    # The value of the count for the Deadline Date
    # 
    # This property is not applicable if `ScheduleDeadlineDateMethod` is set to `LastDayOfMonth` or `NoDeadlineDate`.
    # 
    # Example of usage: <table> <thead>
    # <th>ScheduleDeadlineDateMethod</th>
    # <th>ScheduleDeadlineDateDays</th>
    # <th>Read Deadline Date as</th>
    # </thead> <tbody>
    # <tr>
    # <td>DaysFromStartDate</td>
    # <td>7</td>
    # <td>7 days after start date</td>
    # </tr>
    # <tr>
    # <td>DayOfMonth</td>
    # <td>7</td>
    # <td>7th day of the current month</td>
    # </tr>
    # <tr>
    # <td>LastDayOfMonth</td>
    # <td>N/A</td>
    # <td>Last day of the current month</td>
    # </tr>
    # <tr>
    # <td>DayOfNextMonth</td>
    # <td>7</td>
    # <td>7th day of the next month</td>
    # </tr>
    # <tr>
    # <td>NoDeadlineDate</td>
    # <td>N/A</td>
    # <td>Work has no deadline date</td>
    # </tr>
    # </tbody> </table>
    @jsondata:Name {value: "ScheduleDeadlineDateDays"}
    int:Signed32 scheduleDeadlineDateDays?;
    # You can automatically create a Work Item before its Start date. Use this property to set the multiple of delay unit between Start date and Work Item creation date
    @jsondata:Name {value: "InitializeBeforeStartDateMultiple"}
    int:Signed32 initializeBeforeStartDateMultiple?;
    # If the value of this property is set to `true`, the Work Item will not start on Weekends
    @jsondata:Name {value: "PreventStartEndOnWeekend"}
    boolean preventStartEndOnWeekend;
    # The method that should be used to count the Due Date for the Work Item
    @jsondata:Name {value: "ScheduleDueDateMethod"}
    "DaysFromStartDate"|"DayOfMonth"|"LastDayOfMonth"|"DayOfNextMonth"|"DayOfSubsequentMonth"|"NoDueDate" scheduleDueDateMethod;
    # The value to denote the number of the months, if the deadline date is after 2 months.
    # 
    # This property is only applicable if `ScheduleDeadlineDateMethod` is set to `DayOfSubsequentMonth`.
    # 
    # Example of usage: <table> <thead>
    # <th>ScheduleDeadlineDateMethod</th>
    # <th>ScheduleDeadlineDateDays</th>
    # <th>ScheduleDeadlineDateMonthMultiple</th>
    # <th>Read Deadline Date as</th>
    # </thead> <tbody>
    # <tr>
    # <td>DaysFromStartDate</td>
    # <td>7</td>
    # <td>3</td>
    # <td>7th day of the 3rd month after start date</td>
    # </tr>
    # </tbody> </table>
    @jsondata:Name {value: "ScheduleDeadlineDateMonthMultiple"}
    int:Signed32 scheduleDeadlineDateMonthMultiple?;
};

