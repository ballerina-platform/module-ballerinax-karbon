# Represents the Queries record for the operation: listFiles
public type ListFilesQueries record {
    # The unique key to list files for
    @http:Query {name: "EntityKey"}
    string entityKey;
    # Skip the first n files after filtering and sorting
    @http:Query {name: "$skip"}
    int skip?;
    # Limit the number of files returned, up to 100
    @http:Query {name: "$top"}
    int top?;
    # When this parameter is combined with the URI, this endpoint will return a subset of the files that satisfy the `$filter` expression. Supports `IsArchived`, `IsShared`, `Source` and `MimeType` with the `eq` operator, combined with `and`
    @http:Query {name: "$filter"}
    string filter?;
    # Sort the files by upload date. Newest first when omitted
    @http:Query {name: "$orderby"}
    "DateCreated"|"DateCreated desc" orderby = "DateCreated desc";
};

# A list of Integration Task Definitions
public type IntegrationTaskDefinition record {
    # The name of the specific Integration Task Definition
