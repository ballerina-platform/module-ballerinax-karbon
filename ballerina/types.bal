    @jsondata:Name {value: "BillableValue"}
    decimal billableValue;
    @jsondata:Name {value: "Timeline"}
    ExpenseRequestTimeline timeline;
    # A description of the Expense. Limited to 250 characters
    @jsondata:Name {value: "Description"}
    string description;
    # The date the Expense was incurred
    @jsondata:Name {value: "ExpenseDate"}
    string expenseDate;
    # The cost of the Expense. Cannot be negative
    @jsondata:Name {value: "Value"}
    decimal value;
};

