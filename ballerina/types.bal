    string userKey?;
    # The total estimated time (in minutes) for the task to be completed
    @jsondata:Name {value: "EstimateMinutes"}
    int estimateMinutes?;
    # A randomly generated GUID. Changing HourlyRate on a PATCH can reissue this key — use the OData-EntityId response header to get the current one
    @jsondata:Name {value: "EstimateSummaryKey"}
