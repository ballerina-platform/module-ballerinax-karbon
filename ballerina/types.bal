    # A Karbon-generated unique identifier for the task
    @jsondata:Name {value: "TaskTypeKey"}
    string taskTypeKey?;
    # The name of the task
    @jsondata:Name {value: "TaskTypeName"}
    string taskTypeName?;
    # The hourly rate of the user
    @jsondata:Name {value: "HourlyRate"}
    decimal hourlyRate?;
    # The estimated cost of the task, calculated from the estimated time at the user's hourly rate
    @jsondata:Name {value: "EstimateAmount"}
