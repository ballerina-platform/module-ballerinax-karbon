    # The current parent-level Status of the Work Item. If `WorkStatus` and `PrimaryStatus` have different values, `PrimaryStatus` will be the source of truth for Work Item status
    @jsondata:Name {value: "PrimaryStatus"}
    "Planned"|"ReadyToStart"|"InProgress"|"Waiting"|"Completed" primaryStatus?;
