    @jsondata:Name {value: "TaskPrimaryLinkLabel"}
    anydata taskPrimaryLinkLabel?;
    # The optional default primary link URL of the specific Integration Task Definition
    @jsondata:Name {value: "TaskPrimaryLinkUrl"}
    anydata taskPrimaryLinkUrl?;
    # The list of allowed hostnames that the primary and secondary link URLs must match
    @jsondata:Name {value: "AllowedTaskUrlHosts"}
    string[] allowedTaskUrlHosts?;
    # The optional default label for the primary link URL of the specific Integration Task Definition
    @jsondata:Name {value: "TaskSecondaryLinkLabel"}
    anydata taskSecondaryLinkLabel?;
    # The optional default primary link URL of the specific Integration Task Definition
    @jsondata:Name {value: "TaskSecondaryLinkUrl"}
    anydata taskSecondaryLinkUrl?;
    # The unique ID of the specific Integration Task Definition
    @jsondata:Name {value: "TaskDefinitionKey"}
    string taskDefinitionKey?;
    # The list of locales and languages the integration task definition is suitable for use with, useful when different definitions are required for different languages or locales
    @jsondata:Name {value: "Locales"}
    string[] locales?;
};

