    string contactType?;
    # The first name of the Contact
    @jsondata:Name {value: "FirstName"}
    string firstName;
    # The privacy level for this Contact.
    # 
    # <ul><li>Public Contacts can be managed by anyone in the firm</li> <li>Private Contacts can only be managed by the [Client Team](https://help.karbonhq.com/en/articles/1524707-create-a-client-team). Basic details (name of the Contacts and the Work Items) related to such Contacts are visible to anyone in the firm.</li> <li>Hidden Contacts are only be visible to and managed by the [Client Team](https://help.karbonhq.com/en/articles/1524707-create-a-client-team).</li>
    # Setting `Private` requires the calling API application to have the `IncludePrivate` permission; setting `Hidden` requires `IncludeHidden`. `Public` is always allowed. Omitting this field on a PUT leaves the existing value unchanged
    @jsondata:Name {value: "RestrictionLevel"}
    "Public"|"Private"|"Hidden" restrictionLevel = "Public";
    # The team member in your firm who looks after client relationship or is responsible for the vast majority of the work of the Contact. You can only use the UserKey or the email address of an existing team member
    @jsondata:Name {value: "ClientOwner"}
